# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a Redirect URI registered in the dashboard exactly
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Filled in automatically by: python -m podcast_fit.auth
SPOTIFY_REFRESH_TOKEN=

